#!/usr/bin/env python3
"""pricewatch - volg een product, hoor wanneer het ergens goedkoop is.

Werkt vanuit elke locatie: de module staat in ../src naast dit script, en na
installatie in ~/.config/omarchy/plugins/pricewatch/src. Geen virtualenv, geen
dependencies; alleen de standaardbibliotheek van python3.
"""

import os
import sys

SELF = os.path.realpath(__file__)
HERE = os.path.dirname(SELF)
for candidate in (os.path.join(os.path.dirname(HERE), "src"), os.path.join(HERE, "..", "src")):
    if os.path.isdir(os.path.join(candidate, "pricewatch")):
        sys.path.insert(0, os.path.abspath(candidate))
        break

from pricewatch.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())